void drawFrame(int frameIndex) {
  display.clearDisplay();
  display.drawBitmap(0, 0, video_frames[frameIndex], 128, 64, SH110X_WHITE);
  display.display();
}

// --- MOVEMENT ENGINE (Soft Landing Gait) ---
void smoothMove(int h0, int h1, int h2, int h3, int wait, int stepAmount) {
  bool isMoving = true;
  while(isMoving) {
    isMoving = false; 
    if(p0 < h0) { p0 += stepAmount; if(p0 > h0) p0 = h0; isMoving = true; }
    if(p0 > h0) { p0 -= stepAmount; if(p0 < h0) p0 = h0; isMoving = true; }
    if(p1 < h1) { p1 += stepAmount; if(p1 > h1) p1 = h1; isMoving = true; }
    if(p1 > h1) { p1 -= stepAmount; if(p1 < h1) p1 = h1; isMoving = true; }
    if(p2 < h2) { p2 += stepAmount; if(p2 > h2) p2 = h2; isMoving = true; }
    if(p2 > h2) { p2 -= stepAmount; if(p2 < h2) p2 = h2; isMoving = true; }
    if(p3 < h3) { p3 += stepAmount; if(p3 > h3) p3 = h3; isMoving = true; }
    if(p3 > h3) { p3 -= stepAmount; if(p3 < h3) p3 = h3; isMoving = true; }

    pwm.writeMicroseconds(0, p0);
    pwm.writeMicroseconds(1, p1);
    pwm.writeMicroseconds(2, p2);
    pwm.writeMicroseconds(3, p3);
    if(isMoving) delay(wait);
  }
}

void handleWave() {
  Serial.println("ACTION: Waving");
  smoothMove(CENTER, CENTER, CENTER, CENTER + 800, 1, 2); 
  delay(3000); 
  smoothMove(CENTER, CENTER, CENTER, CENTER, 25, 8); 
  server.send(200, "application/json", "{\"status\":\"executed\",\"action\":\"wave\"}");
}

void handleWalk() {
  int n = server.hasArg("n") ? server.arg("n").toInt() : 1;
  Serial.printf("ACTION: Walking %d steps\n", n);
  
  int L_Arm_FWD = CENTER - STEP_SIZE;  int L_Arm_BWD = CENTER + STEP_SIZE;
  int L_Leg_FWD = CENTER - STEP_SIZE;  int L_Leg_BWD = CENTER + STEP_SIZE;
  int R_Arm_FWD = CENTER + STEP_SIZE;  int R_Arm_BWD = CENTER - STEP_SIZE;
  int R_Leg_FWD = CENTER + STEP_SIZE;  int R_Leg_BWD = CENTER - STEP_SIZE;

  for(int i=0; i<n; i++) {
    smoothMove(L_Arm_FWD, CENTER, CENTER, R_Arm_FWD, 3, 2); 
    delay(200);
    smoothMove(L_Arm_FWD, L_Leg_BWD, R_Leg_BWD, R_Arm_FWD, 3, 2); 
    delay(200);
    smoothMove(L_Arm_BWD, L_Leg_BWD, R_Leg_BWD, R_Arm_BWD, 3, 2); 
    delay(200);
    smoothMove(L_Arm_BWD, L_Leg_FWD, R_Leg_FWD, R_Arm_BWD, 3, 2); 
    delay(200);
  }
  smoothMove(CENTER, CENTER, CENTER, CENTER, 3, 2);
  server.send(200, "application/json", "{\"status\":\"executed\",\"action\":\"walk\"}");
}

void setup() {
  Serial.begin(115200);
  Wire.begin(4, 5); 
  
  pwm.begin();
  pwm.setPWMFreq(50);

  if(display.begin(OLED_ADDR, true)) {
    display.clearDisplay();
    display.setTextSize(1);
    display.setTextColor(SH110X_WHITE);
    display.setCursor(0, 10);
    display.println("Caduceus: Booting...");
    display.display();
  }

  pwm.writeMicroseconds(0, CENTER);
  pwm.writeMicroseconds(1, CENTER);
  pwm.writeMicroseconds(2, CENTER);
  pwm.writeMicroseconds(3, CENTER);

  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\n✅ Connection Established");
  server.on("/salla", handleWave);
  server.on("/ileri", handleWalk);
  server.begin();
}

void loop() {
  server.handleClient();
  
  if (millis() - lastFrameTime > FRAME_DELAY) {
    drawFrame(currentFrame);
    currentFrame = (currentFrame + 1) % TOTAL_FRAMES;
    lastFrameTime = millis();
  }
}
